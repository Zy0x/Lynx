#!/system/bin/sh
# Lynx Universal - Modern Termux Interactive Console (lynx)
# Powered by Lxcore & State Engine (100% 2-Way Sync Compliant)

MODPATH="/data/adb/modules/Lynx"
LXCORE="$MODPATH/system/bin/Lxcore"

C_CYAN="\033[1;36m"
C_GREEN="\033[1;32m"
C_YELLOW="\033[1;33m"
C_RED="\033[1;31m"
C_MAGENTA="\033[1;35m"
C_RESET="\033[0m"
C_DIM="\033[2m"

clear_screen() {
    clear 2>/dev/null || printf "\033c"
}

get_state() {
    sh "$LXCORE" state get "$1" 2>/dev/null
}

show_header() {
    clear_screen
    local prof=$(get_state "active_profile")
    local soc=$(cat "$MODPATH/target_soc" 2>/dev/null | tr -d '[:space:]')
    if [ -z "$soc" ] || [ "$soc" = "unknown" ] || [ "$soc" = "generic" ]; then
        if [ -f "$MODPATH/core/lib/hw_probe.sh" ]; then
            . "$MODPATH/core/lib/hw_probe.sh"
            local real_soc=$(detect_real_soc)
            [ "$real_soc" != "generic" ] && soc="$real_soc"
        fi
    fi
    [ -z "$soc" ] && soc="generic"
    echo -e "${C_CYAN}━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━${C_RESET}"
    echo -e "${C_CYAN}  ⚡ L Y N X   [Codename: Deity]   3.0.0${C_RESET}"
    echo -e "${C_CYAN}  Author: ɴᴏɪʀ  |  SoC: ${C_GREEN}${soc}${C_CYAN}  |  Profile: ${C_YELLOW}${prof}${C_RESET}"
    echo -e "${C_CYAN}━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━${C_RESET}"
}

menu_profile() {
    show_header
    echo -e "  ${C_GREEN}PILIH PROFIL PERFORMA:${C_RESET}"
    echo -e "  [1] 🤖 Auto (AI)      - Adaptive Foreground Watcher"
    echo -e "  [2] ⚖️  Balance        - Daily Energy-Aware Efficiency"
    echo -e "  [3] 🚀 Performance    - Sustained High Clocks for Gaming"
    echo -e "  [4] 🔥 Extreme        - Unrestricted (Phone Cooler Req.)"
    echo -e "  [5] 🔋 Powersave      - Maximum Battery Life"
    echo -e "  [6] 💤 Standby/Dormant- Safe Baseline Mode"
    echo -e "  [0] ↩️  Kembali"
    echo ""
    printf "  Pilih opsi [0-6]: "
    read -r opt
    case "$opt" in
        1) sh "$LXCORE" profile auto ;;
        2) sh "$LXCORE" profile balance ;;
        3) sh "$LXCORE" profile performance ;;
        4) sh "$LXCORE" profile extreme ;;
        5) sh "$LXCORE" profile powersave ;;
        6) sh "$LXCORE" profile dormant ;;
        *) return ;;
    esac
    echo -e "${C_GREEN}✅ Profil berhasil diperbarui!${C_RESET}"
    sleep 1.2
}

menu_charging() {
    show_header
    local bypass=$(get_state "charging.bypass_enabled")
    local cur=$(get_state "charging.limit_current_ma")
    echo -e "  ${C_GREEN}PENGATURAN CHARGING CONTROLLER:${C_RESET}"
    echo -e "  • Bypass Charging Aktif : ${C_YELLOW}${bypass}${C_RESET}"
    echo -e "  • Batas Arus Gaming     : ${C_YELLOW}${cur} mA${C_RESET}"
    echo ""
    echo -e "  [1] Toggle Bypass Charging (ON/OFF)"
    echo -e "  [2] Set Batas Arus (1500mA - Aman)"
    echo -e "  [3] Set Batas Arus (2400mA - Cepat)"
    echo -e "  [4] Set Batas Arus (3500mA - Turbo)"
    echo -e "  [0] ↩️  Kembali"
    echo ""
    printf "  Pilih opsi [0-4]: "
    read -r opt
    case "$opt" in
        1)
            if [ "$bypass" = "true" ]; then
                sh "$LXCORE" state set "charging.bypass_enabled" false
            else
                sh "$LXCORE" state set "charging.bypass_enabled" true
            fi
            ;;
        2) sh "$LXCORE" state set "charging.limit_current_ma" 1500 ;;
        3) sh "$LXCORE" state set "charging.limit_current_ma" 2400 ;;
        4) sh "$LXCORE" state set "charging.limit_current_ma" 3500 ;;
        *) return ;;
    esac
    echo -e "${C_GREEN}✅ Setelan charging diperbarui!${C_RESET}"
    sleep 1.2
}

menu_advanced() {
    show_header
    local wifi=$(get_state "network.wifi_ping_stabilizer")
    local therm=$(get_state "thermal.full_bypass")
    local touch=$(get_state "display_touch.touchboost")
    local joyose=$(get_state "oem_neutralizer.joyose_neutralize")
    echo -e "  ${C_GREEN}ADVANCED ENGINE TOGGLES:${C_RESET}"
    echo -e "  [1] Wi-Fi Ping Stabilizer   : ${C_YELLOW}${wifi}${C_RESET}"
    echo -e "  [2] Full Thermal Bypass     : ${C_YELLOW}${therm}${C_RESET}"
    echo -e "  [3] TouchBoost & 120Hz Lock : ${C_YELLOW}${touch}${C_RESET}"
    echo -e "  [4] Netralkan Joyose/GOS    : ${C_YELLOW}${joyose}${C_RESET}"
    echo -e "  [0] ↩️  Kembali"
    echo ""
    printf "  Pilih toggle [0-4]: "
    read -r opt
    case "$opt" in
        1) [ "$wifi" = "true" ] && val=false || val=true; sh "$LXCORE" state set "network.wifi_ping_stabilizer" $val ;;
        2) [ "$therm" = "true" ] && val=false || val=true; sh "$LXCORE" state set "thermal.full_bypass" $val ;;
        3) [ "$touch" = "true" ] && val=false || val=true; sh "$LXCORE" state set "display_touch.touchboost" $val ;;
        4) [ "$joyose" = "true" ] && val=false || val=true; sh "$LXCORE" state set "oem_neutralizer.joyose_neutralize" $val ;;
        *) return ;;
    esac
    echo -e "${C_GREEN}✅ Status fitur berhasil diperbarui!${C_RESET}"
    sleep 1.2
}

menu_busybox() {
    show_header
    echo -e "  ${C_GREEN}PENGATURAN VARIAN BUSYBOX:${C_RESET}"
    echo -e "  [1] ⚡ Feravolt ARM64 (Default Modern 64-bit)"
    echo -e "  [2] 🚀 Feravolt ARMv8 (High-Performance)"
    echo -e "  [3] 📱 Feravolt ARMv7 (32-bit Legacy)"
    echo -e "  [4] 💻 Feravolt x86/x86_64"
    echo -e "  [5] 🔥 Brutal BusyBox (Chimera Edition)"
    echo -e "  [6] ℹ️  Cek Status BusyBox Saat Ini"
    echo -e "  [0] ↩️  Kembali"
    echo ""
    printf "  Pilih opsi [0-6]: "
    read -r opt
    case "$opt" in
        1) sh "$LXCORE" busybox feravolt64 ;;
        2) sh "$LXCORE" busybox feravolt8 ;;
        3) sh "$LXCORE" busybox feravolt7 ;;
        4) sh "$LXCORE" busybox feravolt86 ;;
        5) sh "$LXCORE" busybox brutal ;;
        6)
            show_header
            sh "$LXCORE" busybox status
            echo ""
            echo "Tekan [Enter] untuk kembali..."; read -r _
            return
            ;;
        *) return ;;
    esac
    sleep 1.5
}

while true; do
    show_header
    echo -e "  [1] ⚡ Ganti Profil Performa"
    echo -e "  [2] 🔋 Charging Controller & Motherboard Bypass"
    echo -e "  [3] ⚙️  Advanced Engine (Thermal, Touch, Wi-Fi, Joyose)"
    echo -e "  [4] 🧹 Jalankan CCleaner (Memory & Cache Compaction)"
    echo -e "  [5] 🗄️  Optimasi SQLite & Storage TRIM"
    echo -e "  [6] 📦 Ekspor Laporan Diagnostik 1-Klik (.ZIP)"
    echo -e "  [7] 📊 Status Lengkap Sistem"
    echo -e "  [8] 🧰 Pengaturan Varian BusyBox"
    echo -e "  [0] 🚪 Keluar"
    echo ""
    printf "  Pilih menu [0-8]: "
    read -r choice
    case "$choice" in
        1) menu_profile ;;
        2) menu_charging ;;
        3) menu_advanced ;;
        4)
            echo -e "${C_YELLOW}Menjalankan pembersihan cache & RAM...${C_RESET}"
            sh "$LXCORE" ccleaner
            echo -e "${C_GREEN}Selesai!${C_RESET}"; sleep 1.5
            ;;
        5)
            echo -e "${C_YELLOW}Menjalankan SQLite VACUUM & Storage TRIM...${C_RESET}"
            sh "$LXCORE" maintenance
            echo -e "${C_GREEN}Selesai!${C_RESET}"; sleep 1.5
            ;;
        6)
            echo -e "${C_YELLOW}Membuat laporan diagnostik...${C_RESET}"
            sh "$LXCORE" log export
            echo -e "${C_GREEN}Laporan tersimpan di /sdcard/Lynx/${C_RESET}"; sleep 2
            ;;
        7)
            show_header
            sh "$LXCORE" status
            echo ""
            echo "Tekan [Enter] untuk kembali..."; read -r _
            ;;
        8) menu_busybox ;;
        0|q|exit)
            clear_screen
            exit 0
            ;;
        *)
            ;;
    esac
done