# ==============================================================================
# Lynx Universal - Qualcomm Snapdragon Safe System Properties
# Strictly universal Qualcomm vendor performance hints.
#
# NOTE (Zero-Default-Risk):
# High-risk compositor and renderengine properties (such as debug.sf.latch_unsignaled,
# debug.sf.disable_backpressure, debug.hwui.renderer, vendor.gralloc.enable_fb_ubwc,
# and core_ctl overrides) are NOT enabled by default here to prevent display glitches,
# camera/video black screens, and bootloops across diverse OEM ROMs.
# They are managed interactively with user consent via LynxCompanion (Domain 4).
# ==============================================================================

# ── 1. Qualcomm Input & Touch Responsiveness (Safe Vendor Opts) ───────────────
persist.vendor.qti.inputopts.enable=true
persist.vendor.qti.inputopts.touchboost=true
vendor.perf.gestureflingboost.enable=true
ro.vendor.perf.scroll_opt=true

# ── 2. Qualcomm Game Profiling Hints ──────────────────────────────────────────
persist.vendor.qti.games.gt.prof=1
sys.games.gt.prof=1

# ── 3. Low-Latency Fast Network Sockets ───────────────────────────────────────
net.ipv4.tcp_fastopen=3
