# ==============================================================================
# Lynx Universal - MediaTek Dimensity & Helio Safe System Properties
# Strictly universal MediaTek vendor driver performance hints.
# 
# NOTE (Zero-Default-Risk):
# Display and refresh rate modifications are managed interactively via LynxCompanion
# and are NOT enabled by default to prevent refresh rate flickering or touch anomalies.
# ==============================================================================

# ── 1. MediaTek GED & Graphics Driver Performance Flags ───────────────────────
persist.vendor.ged.boost_enable=1
persist.vendor.ged.smart_boost=1

# ── 2. MediaTek Power HAL Log Flood Suppression (Android 14 GSI EXPENSIVE_RENDERING)
persist.log.tag.mtkpower@impl=S
persist.log.tag.libPowerHal=S

# ── 3. SurfaceFlinger & Mali GPU Frame Pacing Guard (Zero-Jitter High-FPS Phases) ──
debug.sf.enable_gl_backpressure=0
debug.sf.early_phase_offset_ns=1000000
debug.sf.early_app_phase_offset_ns=1500000
debug.sf.high_fps_early_phase_offset_ns=1000000
debug.sf.high_fps_early_app_phase_offset_ns=1500000
debug.sf.early_gl_phase_offset_ns=1000000
debug.sf.early_gl_app_phase_offset_ns=1500000


# ── 4. Touch Digitizer (Novatek NT36672C) Responsiveness & Low-Latency ────────
# Note: view.touch_slop and ro.input.resampling must NOT be artificially overridden
# to prevent touch jitter, missed fast typing, and multi-touch gesture collisions.
persist.sys.touch.latency=0
debug.touch.frequency.boost=1
