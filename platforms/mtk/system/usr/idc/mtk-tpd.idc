# Novatek NT36672C Touchscreen Calibration for Infinix Note 11s / Note 11 Pro (X698)
# Platform: MediaTek Helio G96 (MT6781)
# Optimization: Ultra-Precision 1:1 Pixel Aiming & Zero-Acceleration Scope Control

touch.deviceType = touchScreen
touch.orientationAware = 1

# Linear 1:1 Geometric Mapping (Zero artificial deadzones)
touch.size.calibration = area
touch.size.scale = 1
touch.size.bias = 0
touch.size.isSummed = 0

# Pressure Calibration
touch.pressure.calibration = amplitude
touch.pressure.scale = 0.005

# Raw Direct Coordinate Dispatch
touch.orientation.calibration = none
touch.distance.calibration = none

# Touch Gesture & Spots for Gaming
touch.gestureMode = spots
