# Lynx Universal - Hardware Sensor Native Init Trigger
# Wakes up physical sensor nodes (lsm6dsm & mn78911) during early-boot BEFORE class main starts!

on early-boot
    write /sys/class/sensor/m_acc_misc/accactive 100
    write /sys/class/sensor/m_gyro_misc/gyroactive 100
    write /sys/class/sensor/m_als_misc/alsactive 100
    write /sys/class/sensor/m_ps_misc/psactive 100

on boot
    write /sys/class/sensor/m_acc_misc/accactive 100
    write /sys/class/sensor/m_gyro_misc/gyroactive 100
    write /sys/class/sensor/m_als_misc/alsactive 100
    write /sys/class/sensor/m_ps_misc/psactive 100
