# Show First Menu
show_menu

# Read Input User
while true; do
    read -rsn1 input

    case $input in
        A) # Up Arrow
            if [ $selected -gt 0 ]; then
                selected=$((selected - 1))
            else
                selected=$((num_options - 1))
            fi
            show_menu
            ;;
        B) # Down Arrow
            if [ $selected -lt $((num_options - 1)) ]; then
                selected=$((selected + 1))
            else
                selected=0
            fi
            show_menu
            ;;
        C) # Right Arrow
            if [ $selected -lt $((num_options - 1)) ]; then
                selected=$((selected + 1))
            else
                selected=0
            fi
            show_menu
            ;;
        D) # Left Arrow
            if [ $selected -gt 0 ]; then
                selected=$((selected - 1))
            else
                selected=$((num_options - 1))
            fi
            show_menu
            ;;
        H) # Home Button
            selected=0
            show_menu
            ;;
        F) # End Button
            echo -e "\033[1A" 
            echo -e "\033[K"  
            echo -e "\033[31mExit Chimera!\033[0m"
            sleep 1.25
            clear
            pkill -9 termux && break || exit
            ;;
        $'\x7f') # Backspace Button
            if [ $selected -eq 0 ]; then
                echo -e "\033[1A"
                echo -e "\033[K"  
                echo -e "\033[31mExit Chimera!\033[0m"
                sleep 1.25
                clear
                exit
            else
                selected=0
                show_menu
            fi
            ;;
        "") # Enter
            if [ $selected -eq 0 ]; then
                show_mode_menu
                # Read Input
                while true; do
                    read -rsn1 mode_input
                    case $mode_input in
                        A) # Up Arrow
                            if [ $mode_selected -gt 0 ]; then
                                mode_selected=$((mode_selected - 1))
                            else
                                mode_selected=$((num_mode_options - 1))
                            fi
                            show_mode_menu
                            ;;
                        B) # Down Arrow
                            if [ $mode_selected -lt $((num_mode_options - 1)) ]; then
                                mode_selected=$((mode_selected + 1))
                            else
                                mode_selected=0
                            fi
                            show_mode_menu
                            ;;
                        C) # Right Arrow
                            if [ $mode_selected -lt $((num_mode_options - 1)) ]; then
                                mode_selected=$((mode_selected + 1))
                            else
                                mode_selected=0
                            fi
                            show_mode_menu
                            ;;
                        D) # Left Arrow
                            if [ $mode_selected -gt 0 ]; then
                                mode_selected=$((mode_selected - 1))
                            else
                                mode_selected=$((num_mode_options - 1))
                            fi
                            show_mode_menu
                            ;;
                        H) # Home Button
                            mode_selected=0
                            show_menu
                            break
                            ;;
                        F) # End Button
                            echo -e "\033[1A" 
                            echo -e "\033[K"  
                            echo -e "\033[31mExit Chimera!\033[0m"
                            sleep 1.25
                            clear
                            exit
                            ;;
                        $'\x7f') # Backspace Button
                            if [ $mode_selected -eq 0 ]; then
                                show_menu
                                break
                            else
                                mode_selected=0
                                show_mode_menu
                            fi
                            ;;
                        "") # Enter
                            if [ $mode_selected -eq 0 ]; then
                                setprop chimera.mode notset
                                setprop chimera.control 0
                                echo -e "\e[32mAuto (AI) Mode Enabled\e[0m"
                                sleep 1.25
                                mode_selected=0
                                selected=0
                                show_menu
                                break
                            elif [ $mode_selected -eq 1 ]; then
                                setprop chimera.mode std
                                setprop chimera.control 0
                                echo -e "\e[32mBalance Mode Enabled\e[0m"
