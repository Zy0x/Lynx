# Break Menu
stop_menu_flow=false

# UI Color
BRIGHT_CYAN="\e[96m"
BRIGHT_RED="\e[91m"
RESET="\e[0m"
DIM="\e[2m"

#MENU
## First Menu
## Opt Menu
options=("Chimera Mode" "Thermal Control" "Charging Control" "Flow" "Eterna" "List App Performance" "List App Flow & Eterna" "Misc" "Current Settings" "Support" "Exit")
num_options=${#options[@]}
selected=0
## Chimera Mode
mode_options=("Auto (AI)" "Balance" "High Performance" "Powersave" "Return")
num_mode_options=${#mode_options[@]}
mode_selected=0
## Thermal Control
thermal_options=("Enable" "Disable" "Return")
num_thermal_options=${#thermal_options[@]}
thermal_selected=0
## Charging Control 
charging_control_options=("Enable" "Disable" "Set Value" "Set Limit (in Perf.)" "AutoCut Charging" "Return")
num_cc_options=${#charging_control_options[@]}
cc_selected=0
## Flow 
flow_options=("Enable" "Disable" "Flow Mode" "Return")
num_flow_options=${#flow_options[@]}
flow_selected=0
## Eterna 
eterna_options=("Enable" "Disable" "Return")
num_eterna_options=${#eterna_options[@]}
eterna_selected=0
## List App Performance
perf_options=("Current Active App " "Add an App" "Delete App" "Return")
num_perf_options=${#perf_options[@]}
perf_selected=0
## List App Flow dan Eterna 
flet_options=("Current Active App " "Add an App" "Delete App" "Return")
num_flet_options=${#flet_options[@]}
flet_selected=0

### SECOND MENU
### Charging Control 
autocut_options=("Enable" "Disable" "Set Min" "Set Max" "Return")
num_ac_options=${#autocut_options[@]}
ac_selected=0
### Flow Mode
fm_options=("Basic" "Advance" "High" "Extreme" "Return")
num_fm_options=${#fm_options[@]}
fm_selected=0
### Misc
misc_options=("GPU Cache Cleaner" "Google Logout Fixer" "Tweak Genshin Impact" "Clear Ram (Experiental)" "Return" )
num_misc_options=${#misc_options[@]}
misc_selected=0
### GI
gi_options=("OpenGL" "Vulkan" "Return")
num_gi_options=${#gi_options[@]}
gi_selected=0

# Func menu
show_menu() {
    clear
    echo -e "\033[1;30;94m 𝙲𝚛𝚎𝚍𝚒𝚝: 𝙽𝚘𝚒𝚛 \033[0m"
    echo ""
    echo "----------------------------------"
    echo -e "\033[33m\"         Chimera Option         \"\033[0m"
    echo "----------------------------------"
    echo -e " ${DIM}${BRIGHT_CYAN}(↑↓←→) ${BRIGHT_RED}| ${BRIGHT_CYAN}(↵) ${BRIGHT_RED}| ${BRIGHT_CYAN}BKSP ${BRIGHT_RED}| ${BRIGHT_CYAN}END ${BRIGHT_RED}| ${BRIGHT_CYAN}HOME${RESET}"
    echo ""
    i=0
    while [ $i -lt $num_options ]; do
        if [ $i -eq $selected ]; then
            if [ "$i" -eq $(($num_options - 1)) ]; then
                echo -e "\e[0;35m ${options[i]}\e[0m"
            elif [ "$i" -eq $(($num_options - 2)) ]; then
                echo -e "\n\e[0;35m ${options[i]}\e[0m" 
            else
                echo -e "-> \e[0;35m${options[i]}\e[0m"
            fi
        elif [ $i -eq $(($num_options - 1)) ]; then
            echo -e "\e[0;33m ${options[i]}\e[0m"
        elif [ $i -eq $(($num_options - 2)) ]; then
            echo -e "\n\e[0;34m ${options[i]}\e[0m"
        else
            echo "   ${options[i]}"
        fi
        i=$((i + 1))
    done
}

# Func Mode
show_mode_menu() {
    clear
    echo -e "\033[1;30;94m 𝙲𝚛𝚎𝚍𝚒𝚝: 𝙽𝚘𝚒𝚛 \033[0m"
    echo ""
    echo "----------------------------------"
    echo -e "\033[33m\"        Mode Control        \"\033[0m"
    echo "----------------------------------"
    echo -e " ${DIM}${BRIGHT_CYAN}(↑↓←→) ${BRIGHT_RED}| ${BRIGHT_CYAN}(↵) ${BRIGHT_RED}| ${BRIGHT_CYAN}BKSP ${BRIGHT_RED}| ${BRIGHT_CYAN}END ${BRIGHT_RED}| ${BRIGHT_CYAN}HOME${RESET}"
    echo ""
    mode=$(getprop chimera.mode)
    if [ "$mode" == "high" ]; then
        mode="High Performance"
    elif [ "$mode" == "powersave" ]; then
        mode="Powersave"
    elif [ "$mode" == "std" ]; then
        mode="Balance"
    elif [ "$mode" == "performance" ] || [ "$mode" == "balance" ]; then
        mode="Auto (AI)"
    else
        mode="Unknown"
    fi
    echo -e "Current Mode: \e[0;33m$mode\e[0m"
    echo -e ""
    i=0
    while [ $i -lt $num_mode_options ]; do
        if [ $i -eq $mode_selected ]; then
            if [ "$i" -eq "$(($num_mode_options - 1))" ]; then
                echo -e "-> \e[0;35m${mode_options[i]}\e[0m"
            else
                echo -e "   \e[0;35m${mode_options[i]}\e[0m"
            fi
        else
            if [ "$i" -eq "$(($num_mode_options - 1))" ]; then
                echo -e "   \e[0;33m${mode_options[i]}\e[0m"
            else
                echo "   ${mode_options[i]}"
            fi
        fi
        i=$((i + 1))
    done
}

# Func Mode
show_thermal_menu() {
    clear
    echo -e "\033[1;30;94m 𝙲𝚛𝚎𝚍𝚒𝚝: 𝙽𝚘𝚒𝚛 \033[0m"
    echo ""
    echo "----------------------------------"
    echo -e "\033[33m\"         Thermal Control        \"\033[0m"
    echo "----------------------------------"
    echo -e " ${DIM}${BRIGHT_CYAN}(↑↓←→) ${BRIGHT_RED}| ${BRIGHT_CYAN}(↵) ${BRIGHT_RED}| ${BRIGHT_CYAN}BKSP ${BRIGHT_RED}| ${BRIGHT_CYAN}END ${BRIGHT_RED}| ${BRIGHT_CYAN}HOME${RESET}"
    echo ""
    thermal=$(getprop chimera.thermal)
    if [ "$thermal" == "1" ]; then
        thermal="Enabled"
    elif [ "$thermal" == "0" ]; then
        thermal="Disabled"
    else
        thermal="Unknown"
    fi
    echo -e "Current Mode: \e[0;33m$thermal\e[0m"
    echo -e ""
    i=0
    while [ $i -lt $num_thermal_options ]; do
        if [ $i -eq $thermal_selected ]; then
            if [ "$i" -eq "$(($num_thermal_options - 1))" ]; then
                echo -e "-> \e[0;35m${thermal_options[i]}\e[0m"
            else
                echo -e "   \e[0;35m${thermal_options[i]}\e[0m"
            fi
        else
            if [ "$i" -eq "$(($num_thermal_options - 1))" ]; then
                echo -e "   \e[0;33m${thermal_options[i]}\e[0m"
            else
                echo "   ${thermal_options[i]}"
            fi
        fi
        i=$((i + 1))
    done
}
