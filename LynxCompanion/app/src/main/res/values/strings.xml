    <!-- CPU Tunable Metadata & Guides -->
    <string name="tunable_ramp_up_title">Ramp-Up Rate Limit</string>
    <string name="tunable_ramp_up_desc">Jeda evaluasi kernel sebelum menaikkan frekuensi CPU saat beban komputasi melonjak.</string>
    <string name="tunable_ramp_up_hint_little">Panduan Policy 0: 0 µs (Responsif) • 1 ms (Seimbang) • 10 ms (Hemat Daya)</string>
    <string name="tunable_ramp_up_hint_big">Panduan Policy Big: 0 µs (Instan / Seimbang) • 20 ms (Hemat Daya)</string>
    <string name="tunable_ramp_down_title">Ramp-Down Rate Limit</string>
    <string name="tunable_ramp_down_desc">Durasi penahanan clock tinggi saat beban kerja mereda guna mencegah micro-stutter frekuensi.</string>
    <string name="tunable_ramp_down_hint_little">Panduan Policy 0: 10 ms (Responsif) • 20 ms (Seimbang) • 1 ms (Hemat) • 30 ms (OEM)</string>
    <string name="tunable_ramp_down_hint_big">Panduan Policy Big: 5 ms (Responsif) • 10 ms (Seimbang) • 0.5 ms (Hemat) • 30 ms (OEM)</string>
    <string name="tunable_iowait_title">I/O Wait Boost</string>
    <string name="tunable_iowait_desc">Akselerasi frekuensi CPU secara instan ketika thread terhambat antrean operasi storage.</string>
    <string name="tunable_iowait_hint">Aktifkan untuk respon instan saat operasi I/O storage, atau matikan untuk efisiensi daya.</string>
    <string name="tunable_hispeed_freq_title">HiSpeed Target Frequency</string>
    <string name="tunable_hispeed_freq_desc">Frekuensi acuan awal saat mendeteksi lonjakan beban tiba-tiba sebelum eskalasi bertahap.</string>
    <string name="tunable_hispeed_freq_hint">Satuan kHz. Otomatis dikalibrasi mengikuti titik tengah kurva frekuensi kluster.</string>
    <string name="tunable_up_threshold_title">Ambang Beban Naik (Up Threshold)</string>
    <string name="tunable_up_threshold_desc">Persentase beban kerja CPU minimum untuk memicu eskalasi ke frekuensi lebih tinggi.</string>
    <string name="tunable_up_threshold_hint" formatted="false">Rekomendasi: 65%–75% (Responsif) • 80%–90% (Seimbang)</string>
    <string name="tunable_down_threshold_title">Ambang Beban Turun (Down Threshold)</string>
    <string name="tunable_down_threshold_desc">Batas bawah beban kerja CPU sebelum frekuensi diizinkan turun ke tingkat lebih hemat.</string>
    <string name="tunable_down_threshold_hint" formatted="false">Rekomendasi: 20%–35% (Menjaga kestabilan transisi clock)</string>
    <string name="tunable_sampling_rate_title">Interval Sampling (Sampling Rate)</string>
    <string name="tunable_sampling_rate_desc">Periode polling kernel dalam mengevaluasi pembebanan komputasi CPU.</string>
    <string name="tunable_sampling_rate_hint">Satuan mikrodetik (µs). Contoh: 10000 µs = 10 ms (responsif) • 20000 µs = 20 ms (standar)</string>
    <string name="tunable_sampling_down_factor_title">Sampling Down Factor</string>
    <string name="tunable_sampling_down_factor_desc">Faktor pengali interval evaluasi saat frekuensi berada di tingkat maksimal.</string>
    <string name="tunable_sampling_down_factor_hint">Rekomendasi: 1x (Normal) • 2x–4x (Tahan performa puncak lebih lama)</string>
    <string name="tunable_min_sample_time_title">Waktu Minimum Sampel (Min Sample Time)</string>
    <string name="tunable_min_sample_time_desc">Durasi minimum kernel bertahan pada suatu frekuensi sebelum evaluasi baru.</string>
    <string name="tunable_min_sample_time_hint">Satuan mikrodetik (µs). Contoh: 50000 µs = 50 ms.</string>
